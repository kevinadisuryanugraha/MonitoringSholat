rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Hanya user yang sudah login (authenticated) yang bisa mengakses Firestore
    match /{document=**} {
      allow read, write: if request.auth != null;
    }

    // Aturan khusus per koleksi
    match /users/{userId} {
      // User bisa baca/tulis profilnya sendiri. Kepala Sekolah bisa baca/tulis semua.
      allow read: if request.auth != null;
      allow write: if request.auth.uid == userId || 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'kepala_sekolah';
    }

    match /kelas/{kelasId} {
      allow read: if request.auth != null;
      // Hanya Kepala Sekolah yang bisa menulis data kelas
      allow write: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'kepala_sekolah';
    }

    match /kelompok/{kelompokId} {
      allow read: if request.auth != null;
      // Hanya Kepala Sekolah yang bisa menulis data kelompok
      allow write: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'kepala_sekolah';
    }

    match /santri/{santriId} {
      allow read: if request.auth != null;
      // Kepala Sekolah bisa CRUD penuh, Wali Kelas dan Musyrif hanya read
      allow write: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'kepala_sekolah';
    }

    match /konfigurasi_sholat/{sholatId} {
      allow read: if request.auth != null;
      // Hanya Kepala Sekolah yang bisa mengubah konfigurasi
      allow write: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'kepala_sekolah';
    }

    match /absensi/{absensiId} {
      allow read: if request.auth != null;
      // Musyrif bisa mencatat absensi untuk kelompok yang diampunya.
      // Kepala Sekolah bisa menulis semua.
      allow write: if request.auth.uid == resource.data.musyrifId ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'kepala_sekolah';
    }
  }
}
